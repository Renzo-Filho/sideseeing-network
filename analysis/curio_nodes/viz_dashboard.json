          "UPTOWN (CHI:03)",
          "LINCOLN SQUARE (CHI:04)",
          "NORTH CENTER (CHI:05)",
          "LAKE VIEW (CHI:06)",
          "LINCOLN PARK (CHI:07)",
          "NEAR NORTH SIDE (CHI:08)",
          "EDISON PARK (CHI:09)",
          "NORWOOD PARK (CHI:10)",
          "JEFFERSON PARK (CHI:11)",
          "FOREST GLEN (CHI:12)",
